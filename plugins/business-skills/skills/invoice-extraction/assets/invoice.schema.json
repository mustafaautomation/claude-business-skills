{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.quvantic.com/invoice.schema.json",
  "title": "Invoice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invoice_number",
    "invoice_date",
    "due_date",
    "currency",
    "seller",
    "buyer",
    "line_items",
    "subtotal",
    "tax_rate_percent",
    "tax",
    "total",
    "payment_terms",
    "valid",
    "errors"
  ],
  "properties": {
    "invoice_number": { "type": "string", "minLength": 1 },
    "invoice_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "due_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "seller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address"],
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "tax_id": { "type": "string" }
      }
    },
    "buyer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address"],
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" }
      }
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sku", "description", "quantity", "unit_price", "amount"],
        "properties": {
          "sku": { "type": "string" },
          "description": { "type": "string" },
          "quantity": { "type": "string" },
          "unit_price": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$" },
          "amount": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$" }
        }
      }
    },
    "subtotal": { "type": "string" },
    "tax_rate_percent": { "type": ["string", "null"] },
    "tax": { "type": "string" },
    "total": { "type": "string" },
    "payment_terms": { "type": "string" },
    "valid": { "type": "boolean" },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "message"],
        "properties": {
          "path": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
